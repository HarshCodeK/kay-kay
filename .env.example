# Your application's key for talking to THIS gateway.
# Unset: one is generated into .admin_key on first boot.
KAYKAY_ADMIN_KEY=kk-change-me

# Provider chain, in fallback order. Every provider must be
# OpenAI-wire-compatible.
KAYKAY_PROVIDERS=groq
GROQ_API_KEY=

# Any OpenAI-compatible endpoint, e.g.
# KAYKAY_PROVIDERS=groq,openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
