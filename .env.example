# --- Kay-Kay gateway ---
# The admin key your application uses to talk to THIS gateway.
# If unset, one is generated and stored in .admin_key at first boot.
KAYKAY_ADMIN_KEY=kk-change-me

# Providers, in fallback order. All must be OpenAI-wire-compatible.
KAYKAY_PROVIDERS=groq

# --- Providers ---
GROQ_API_KEY=
# Add any OpenAI-compatible endpoint, e.g.:
# KAYKAY_PROVIDERS=groq,openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# --- Storage ---
# KAYKAY_DB=/path/to/kaykay.db
